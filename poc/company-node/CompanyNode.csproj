<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- العقدة المحلية (نموذج أوّلي) = برنامج حاسبة الشركة.
       يجلب المفتاح العام من البوابة مرّة واحدة عند الإقلاع، ثم يتحقق من كل
       بطاقة دخول ذاتياً (RS256) ويطبّق الصلاحيات — دون سؤال المركز لكل طلب.
       يمثّل العمليات المحلية (المشتركون، المحاسبة) المخزّنة عند الشركة. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sadara.Poc.CompanyNode</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
  </ItemGroup>

</Project>
