<Project Sdk="Microsoft.NET.Sdk">

  <!--
    مشروع اختبار وحدة/تشفير معزول تماماً عن قاعدة البيانات (ADR-002 — RS256/JWKS).
    - لا Testcontainers، لا Npgsql fixtures، لا اتصال DB.
    - يرجع فقط إلى Domain + Infrastructure (حيث Rs256JwtService/JwksService/JwtService).
    - مفاتيح RSA للاختبار تُولَّد وقت التشغيل في الذاكرة ولا تُكتب في المستودع ولا تُطبع.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
    <!-- تُوحّد إصدار EF Core لتفادي CS1705 عند جرّ تبعيات Infrastructure -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Backend\Core\Sadara.Infrastructure\Sadara.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Backend\Core\Sadara.Domain\Sadara.Domain.csproj" />
  </ItemGroup>

</Project>
