<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <!-- تُوحّد إصدارات EF Core مع Sadara.API (يجرّ EF 9.0.2 عبر EFCore.Design) لتفادي CS1705 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.2" />
    <!-- اختبارات ملخّص طلبات الخدمة تتطلب Postgres حقيقياً (::json->>، FILTER، regex ~) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.2" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Backend\Core\Sadara.Infrastructure\Sadara.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Backend\Core\Sadara.Domain\Sadara.Domain.csproj" />
    <ProjectReference Include="..\..\src\Backend\Core\Sadara.Application\Sadara.Application.csproj" />
    <!-- مرجع لطبقة الـ API لاستدعاء ServiceRequestsController.GetSummary فعلياً (SQL + منطق C# + بوابة الصلاحية) -->
    <ProjectReference Include="..\..\src\Backend\API\Sadara.API\Sadara.API.csproj" />
  </ItemGroup>

  <!-- Sadara.API هو Microsoft.NET.Sdk.Web؛ نحتاج إطار ASP.NET Core لتجميع/تحميل الكونترولر -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
