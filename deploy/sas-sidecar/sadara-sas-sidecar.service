# ══════════════════════════════════════════════════════════════════════════════
# sadara-sas-sidecar.service — وحدة systemd لخدمة الساز (SAS sidecar)
#
# هذه نسخة طبق الأصل من الوحدة الحيّة على الإنتاج (72.61.183.61:/etc/systemd/system/)
# مُلتقَطة بتاريخ 2026-11-27 — محفوظة كمرجع/نسخة احتياطية.
#
# الحالة على الإنتاج: active + enabled (تقلع تلقائياً + تتعافى عند الفشل). P0-1 مُطبَّق.
# أسفلها اقتراحات تقوية إضافية (معلّقة) — طبّقها فقط بعد اختبار على staging.
# ══════════════════════════════════════════════════════════════════════════════
[Unit]
Description=Sadara SAS Sidecar (127.0.0.1:8100)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/sadara/sas/service
EnvironmentFile=/etc/sadara/sas-sidecar.env
ExecStart=/opt/sadara/sas/venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8100 --log-level info
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

# ── اقتراحات تقوية إضافية (اختيارية — اختبرها قبل التفعيل) ──
# PrivateTmp=true
# ProtectSystem=strict
# ProtectHome=true
# ReadWritePaths=/opt/sadara/sas/service/data
# ProtectKernelTunables=true
# ProtectControlGroups=true
# RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
