# ==== إعدادات باكند منصة العراق الرقمية ====

# مفتاح تشفير كلمات مرور الأجهزة (غيّره لقيمة عشوائية طويلة)
SECRET_KEY=change-this-to-a-long-random-string

# قاعدة البيانات (SQLite افتراضياً — سهلة للبداية)
DATABASE_URL=sqlite:///./iraq_digital_platform.db

# ==== المصادقة / الأمان ====
# توكن الوصول للـ API. الطلبات تحتاج: Authorization: Bearer <API_TOKEN>
# اتركه فارغاً في وضع المحاكاة فقط (تطوير محلي). مطلوب حتماً في الإنتاج (USE_MOCK_OLT=false).
API_TOKEN=
# الأصول المسموح بها لـ CORS (مفصولة بفاصلة). '*' = الكل (تطوير فقط).
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000

# ==== إدارة المستخدمين والصلاحيات ====
# صلاحية توكن جلسة المستخدم (ساعات)
TOKEN_TTL_HOURS=12
# إنشاء مدير افتراضي عند غياب أي مستخدم (أول تشغيل)
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_USER=admin
# غيّرها في الإنتاج — 'admin' مرفوضة عند USE_MOCK_OLT=false
DEFAULT_ADMIN_PASSWORD=admin

# ==== الذكاء الاصطناعي ====
# مفتاح Claude API — احصل عليه من https://console.anthropic.com
# اتركه فارغاً لتشغيل وضع القواعد الخبيرة فقط (يعمل بدون إنترنت)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
# مهلة طلب Claude API (ثوانٍ)
AI_TIMEOUT=60

# ==== مهلات الاتصال بالـ OLT (Netmiko) ====
# مهلة إنشاء اتصال SSH/TCP (ثوانٍ) ومهلة قراءة مخرجات الأمر
SSH_CONN_TIMEOUT=15
SSH_READ_TIMEOUT=30

# ==== وضع المحاكاة ====
# true = استخدام محاكي OLT (للتطوير والاختبار بدون جهاز حقيقي)
# false = الاتصال بأجهزة OLT حقيقية
USE_MOCK_OLT=true

# فترة سحب بيانات المراقبة بالثواني
MONITOR_INTERVAL=30

# ==== سياسة الاحتفاظ (تنظيف الجداول الزمنية تلقائياً) ====
# حذف قياسات Metric الأقدم من هذا العمر (أيام)
METRIC_RETENTION_DAYS=14
# حذف الإنذارات غير النشطة الأقدم من هذا العمر (أيام) — النشطة تبقى
ALARM_RETENTION_DAYS=30
# فترة تشغيل التنظيف الدوري (ساعات)
RETENTION_SWEEP_HOURS=6

# ==== SNMP ====
# ملاحظة: مفاتيح SNMPv3 لكل جهاز (community/auth-key/priv-key) تُعرَّف
# على مستوى الجهاز في واجهة الإدارة وتُشفَّر في قاعدة البيانات — ليست هنا.

# تشغيل سحّاب SNMP الدوري (true/false)
SNMP_POLL_ENABLED=true

# منفذ UDP لاستقبال SNMP traps من المجمّع (الافتراضي 162 يحتاج صلاحية root/admin؛
# استخدم 1162 في التطوير إن لم تكن تملك الصلاحية)
SNMP_TRAP_PORT=162

# Engine ID لمستقبِل الـ traps — اتركه فارغاً لتوليد تلقائي
SNMP_TRAP_ENGINE_ID=

# فترات السحب الدوري لكل نوع بيانات (بالثواني)
SNMP_HEALTH_INTERVAL=45        # صحّة الـ OLT (CPU / Memory / درجة الحرارة)
SNMP_PON_INTERVAL=180          # ملخّص منافذ PON (ضوء صاعد/هابط، ONTs متصلة)
SNMP_ONT_BASIC_INTERVAL=600    # حالة ONT الأساسية (online/offline/power off)
SNMP_ONT_DETAIL_INTERVAL=2400  # بيانات ONT التفصيلية (مستوى ضوئي، إصدار firmware)

# IPs المجمّع المسموح لها إرسال traps إلى هذا الخادم (مفصولة بفواصل).
# اتركه فارغاً في التطوير (قبول الكل). في الإنتاج قيّد بـ IP المجمّع.
# مثال: SNMP_ALLOWED_SOURCES=192.168.1.1,10.0.0.1
SNMP_ALLOWED_SOURCES=

# مهلة طلب SNMP الواحد (ثوانٍ)
SNMP_TIMEOUT=4.0

# عدد إعادة المحاولة عند فشل طلب SNMP (0 = بلا إعادة)
SNMP_RETRIES=1

# ==== مستخدم SNMPv3 USM لمستقبِل الـ traps ====
# مطلوبة لتشغيل مستقبِل SNMPv3 traps في الإنتاج؛ بدونها لا يبدأ المستقبِل الحقيقي.
# في التطوير (USE_MOCK_OLT=true) تُتجاهل هذه الإعدادات تماماً.

# اسم مستخدم USM المُعرَّف على المجمّع وعلى هذا المستقبِل
SNMP_TRAP_USER=platform-monitor

# بروتوكول المصادقة: SHA | SHA256 | SHA512 | MD5 (يُنصح بـ SHA256 أو أعلى)
SNMP_TRAP_AUTH_PROTO=SHA256

# مفتاح مصادقة استقبال الـ traps — اضبطه بقيمة عشوائية طويلة في الإنتاج
SNMP_TRAP_AUTH_KEY=

# بروتوكول التشفير: AES | AES256 | DES (يُنصح بـ AES أو AES256)
SNMP_TRAP_PRIV_PROTO=AES

# مفتاح تشفير استقبال الـ traps — اضبطه بقيمة عشوائية طويلة في الإنتاج
SNMP_TRAP_PRIV_KEY=
